# Python
__pycache__/
*.py[cod]
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local test logs, screenshots, baseline copies, and disposable databases
/test-output/

# Virtual environments
.venv/
.venv*/
.dev-mail/
.verification/
venv/

# Env files (never commit real secrets)
.env
.env.*
!.env.example

# SQLite databases
*.db
*.sqlite
*.sqlite3

# Godot editor cache & metadata
.godot/
*.godot/editor/
*.godot/imported/
*.godot/mono/

# Specific files shown in your merge conflicts
.godot/editor/uid_cache.bin
.godot/editor/editor_layout.cfg
.godot/editor/filesystem_cache*
.godot/editor/filesystem_update*
.godot/editor/project_metadata.cfg
.godot/editor/recent_dirs

# General Godot cache pattern
.godot/editor/*

# OS/editor
.DS_Store
Thumbs.db
.vscode/

CHANGES.md

# Godot PNG import metadata (regenerated automatically by the editor)
*.png.import

# Built native extensions (built by code/client/native/*/build scripts)
code/client/native/*/bin/
code/client/native/*/build/

