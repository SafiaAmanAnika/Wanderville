# Server configuration for local development.
# Copy to `code/server/.env` and adjust.

WANDEVILLE_ENV=dev
WANDEVILLE_HOST=127.0.0.1
WANDEVILLE_PORT=8000

# PostgreSQL database URL. Use your Neon connection string here if you want a shared database.
# Example: postgresql+psycopg2://USER:PASSWORD@ep-example.us-east-1.aws.neon.tech/wanderville?sslmode=require
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST/wanderville?sslmode=require

# Auth (JWT)
# For local dev: set a long random value in `code/server/.env` (do not commit).
JWT_SECRET_KEY=change-me-in-local-env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Google OAuth
# Create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Email (SMTP) — used for verification and password reset
# In dev mode emails are logged to console; SMTP is only used when WANDEVILLE_ENV=production
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@wanderville.game
EMAIL_BASE_URL=http://localhost:8000
EMAIL_VERIFICATION_EXPIRE_MINUTES=60
PASSWORD_RESET_EXPIRE_MINUTES=30

# Account Security
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Rate Limiting
# Set to 1 to disable (useful for tests)
DISABLE_RATE_LIMIT=

CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
