WANDERVILLE_ENV=dev
WANDERVILLE_HOST=127.0.0.1
WANDERVILLE_PORT=8000
DATABASE_URL=postgresql+psycopg2://wanderville_app:YOUR_LOCAL_PASSWORD@127.0.0.1:5432/wanderville_dev
JWT_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# auto saves .eml in dev/test; smtp/brevo/gmail_api send real email.
EMAIL_DELIVERY=auto
BREVO_API_KEY=
# gmail_api sends through Google's HTTPS API with a stored refresh token,
# so free hosting works without an SMTP port or a purchased domain. Obtain the
# refresh token with: python scripts/configure_auth.py --gmail-api
GMAIL_SENDER_EMAIL=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Keep false for serverless databases; even the idle sweep prevents sleep.
# Use python -m app.modules.world.worker --once for explicit maintenance.
WORLD_WORKER_ENABLED=false
# Reuse passive snapshots between commits; 0 disables, maximum 1 second.
REALTIME_SNAPSHOT_CACHE_SECONDS=1
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
EMAIL_FROM=noreply@wanderville.example
EMAIL_BASE_URL=http://127.0.0.1:8000
EMAIL_VERIFICATION_EXPIRE_MINUTES=60
PASSWORD_RESET_EXPIRE_MINUTES=30
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
STARTING_AURA=0
FARM_CONSUME_INVENTORY=true
FARM_SPRING_GROWTH_RATE=1.0
FARM_SUMMER_GROWTH_RATE=1.25
FARM_AUTUMN_GROWTH_RATE=0.9
FARM_WINTER_GROWTH_RATE=0.75
DEV_ALLOW_WORLD_MUTATION=false
INVENTORY_PARTITION_SLOTS=30
MAX_MOVE_SPEED=3000
CHAT_BLOCKED_WORDS=damn,shit,fuck
# Proximity social backend (single Uvicorn worker only).
PROXIMITY_RADIUS=600
PROXIMITY_EXIT_RADIUS=720
# Native Godot PCM voice uses a separate WebSocket (no media extra required).
# Optional WebRTC clients require requirements-voice.txt and UDP media connectivity.
VOICE_ENABLED=false
VOICE_ROOM_LIMIT=8
VOICE_TOTAL_LIMIT=32
VOICE_STUN_URLS=
# Comma-separated turn:/turns: URLs; coturn use-auth-secret / static-auth-secret.
VOICE_TURN_URLS=
VOICE_TURN_SECRET=
VOICE_TURN_TTL_SECONDS=600
